# --- required ---
DISCORD_TOKEN=put-your-bot-token-here
CLIENT_ID=1561599586190237796

# --- optional ---
PREFIX=z!
OWNER_IDS=your_discord_user_id
STAFF_ROLE_ID=            # staff role: can see/close tickets
VERIFIED_ROLE_ID=         # role given by the Verify button
EVENT_REWARD_DAYS=30       # days of Zera Pro in the /event reward code
LAVALINK_URL=lavalink.nazha.online:443
LAVALINK_PASSWORD=nazhafreelava
LAVALINK_SECURE=true

# premium (optional)
PREMIUM_URL=https://discord.gg/tXeDz3Q3
VOTE_URL=
PREMIUM_SKU_PLUS=
PREMIUM_SKU_PRO=
PREMIUM_SKU_NEXTGEN=
VC_STATUS_EMOJI=true
HQ_BITRATE=true   # when Zera joins a VC, raise its bitrate to the server's maximum (needs Manage Channels; only ever raises) = better sound
DEFAULT_VOLUME=100   # start volume for servers that never set one (100 = unattenuated, cleanest sound)
SEARCH_HEDGE_MS=1200   # if the first search source is slower than this, the next source starts in parallel
VC_IDLE_STATUS=true   # when music ends but Zera stays in the VC, show an animated butterfly + hint as VC status (false = just clear it)
VC_IDLE_TEXT=Use /play and play music   # text of that idle VC status
EMOJI_RESYNC=false   # set to true for ONE start after changing emoji files, then back to false
SUPPORT_GUILD_ID=1538233552985133177   # owner-only commands (premium-*, ...) work only here
STATUS_TEXT=Zera Powered By Zera Support Team and AMC Hosting
STATUS_CHANNEL_ID=1561967886044762192   # live status panel channel
DB_COLLECT_CHANNEL_ID=1562018538787704883   # channel of the owner-only "Collect All Database" panel (OWNER_IDS must be set)

RESTART_PANEL_CHANNEL_ID=1562081864909459516   # owner-only restart panel channel

HOSTINFO_PANEL_CHANNEL_ID=1562106847274602627
# Set these in the hosting panel's environment variables. Do not commit real credentials to GitHub.
HOSTINFO_URL=https://panel.amccloud.site/
HOSTINFO_EMAIL=your-hosting-email@example.com
HOSTINFO_PASSWORD=SET_A_NEW_PASSWORD_HERE

# Premium buy tickets (panel + private purchase tickets)
PREMIUM_BUY_CHANNEL_ID=1562379011114410075
PREMIUM_UPI_ID=            # optional: your UPI id, shown inside the ticket
PREMIUM_UPI_NAME=          # optional: name on that UPI id

# Bot presence
PLAYING_TEXTS={servers} Servers | {users} Users | {vc} Voice Channels Joined | Powered By Zera and AMC   # rotating Playing texts, separate with |  (placeholders: {servers} {users} {vc})
PRESENCE_ROTATE_SECONDS=15   # seconds between texts (min 10)
BOT_VR_ICON=true   # VR headset icon next to the bot (undocumented Discord trick); false = normal icon
KEEP_CUSTOM_STATUS=false   # true = also set the old custom status (STATUS_TEXT); Discord then shows it INSTEAD of the Playing line
